{
  "name": "veyra-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Original framework-free collaboration workspace with WebGPU, WebRTC and documented Microsoft interoperability.",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "node --experimental-sqlite server/index.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "build:microsoft": "node scripts/bundle-microsoft.mjs"
  },
  "optionalDependencies": { "@azure/communication-identity": "1.3.1" },
  "devDependencies": {
    "@azure/msal-browser": "4.26.1",
    "@azure/communication-calling": "1.39.1",
    "@azure/communication-common": "2.4.0",
    "esbuild": "0.25.10"
  }
}
